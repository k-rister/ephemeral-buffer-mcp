                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "maxUtf8Bytes": 256,
              "title": "Idempotency Key"
            },
            "max_output_bytes": {
              "anyOf": [
                {
                  "minimum": 512,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Output Bytes"
            },
            "name": {
              "maxUtf8Bytes": 256,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "side_effects": {
              "default": "none",
