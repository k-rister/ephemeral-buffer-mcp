  {
    "description": "Run a command, index bounded output, and return a compact JSON\n    summary with status, duration, sizes, token estimates, truncation, signals,\n    and optional metrics.\n\n    Use for commands expected to finish within the MCP client's tool-call window\n    when output benefits from bounded capture and later search. Use\n    start_execution when duration may approach or exceed that window, even for a\n    single phase; use direct execution for small targeted inspections. Choose by\n    duration independently of output size; this routing guidance is advisory.\n\n    Verify the command, intended repository, and working directory. Omitted cwd\n    inherits the server process directory; symlinks and shell expansion may\n    target another path. Output bounds do not validate command intent, path\n    identity, or filesystem safety.\n\n    An omitted label is derived from the command. content_type accepts auto\n    (default), diff, log, or text. max_output_bytes defaults to the configured\n    buffer limit and cannot exceed it. timeout_seconds bounds runtime; timeout\n    retains collected output and returns exit code 124. structured_metrics accepts\n    JSON-compatible named metrics.\n    ",
    "inputSchema": {
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "content_type": {
          "default": "auto",
          "enum": [
            "auto",
            "diff",
            "log",
            "text"
          ],
          "title": "Content Type",
          "type": "string"
        },
        "max_output_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Bytes"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "structured_metrics": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structured Metrics"
        }
      },
      "required": [
        "command"
